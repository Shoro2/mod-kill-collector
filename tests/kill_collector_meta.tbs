as c .killcollector status
expect output has "+25% oddities"
expect output has "N3rd: not yet (45 of 45 achievements)"
do c relog
waitfor c exists timeout 30s
wait 2s
as c .killcollector status
expect output has "+25% oddities"
expect output has "N3rd: earned"

cleanup
log kill collector meta done
