#
# mod-kill-collector configuration
#
# Copy this file to mod_kill_collector.conf and adjust as needed.
#

[worldserver]

########################################
#  Master switch
########################################
#    KillCollector.Enable
#        Description: Enable the Kill Collector module.
#        Default:     1 - Enabled
#                     0 - Disabled

KillCollector.Enable = 1

########################################
#  Token reward
########################################
#    KillCollector.TokenItemId
#        Description: item_template.entry of the token a first kill pays (0 = no token).
#        Default:     920200 ("Hunter's Token", this module's SQL)
#    KillCollector.TokensPerFirstKill
#        Description: How many tokens one first kill pays. Tokens that do not fit into the bags arrive by mail.
#        Default:     1
#    KillCollector.AnnounceFirstKill
#        Description: Tell the player in chat about every newly collected creature.
#        Default:     1 - Enabled

KillCollector.TokenItemId = 920200
KillCollector.TokensPerFirstKill = 1
KillCollector.AnnounceFirstKill = 1

########################################
#  Which kills count
########################################
#    Every player the kill rewards collects the creature: the killer and the members of the tapping group
#    in range, also when a pet or totem landed the blow. Kills in battlegrounds and arenas never count.
#
#    KillCollector.IncludeOpenWorld / IncludeInstances
#        Description: Whether kills on open-world maps / in dungeons and raids count.
#        Default:     1 / 1
#    KillCollector.IncludeCritters / IncludeTotems / IncludeNonCombatPets
#        Description: Whether kills of these creature types count.
#        Default:     0 / 0 / 0
#    KillCollector.MinLevelDelta
#        Description: Skip a kill if (creature level - player level) is below this value,
#                     e.g. -10 = creatures more than ten levels below the player do not count.
#                     -100 switches the filter off.
#        Default:     -100

KillCollector.IncludeOpenWorld = 1
KillCollector.IncludeInstances = 1
KillCollector.IncludeCritters = 0
KillCollector.IncludeTotems = 0
KillCollector.IncludeNonCombatPets = 0
KillCollector.MinLevelDelta = -100

########################################
#  Achievements
########################################
#    One achievement per continent and creature type (mod_kill_collector_achievements): it completes when
#    the player has killed every creature of that type the continent spawns (its dungeons and raids
#    included) that the player's team can attack.
#
#    KillCollector.AchievementsEnable
#        Description: Grant the achievements. Switch it on only once the clients have the Achievement.dbc
#                     rows (client patch) and the server has them (Achievement.dbc or achievement_dbc).
#        Default:     0 - Disabled
#    KillCollector.Expected.SkipNpcFlagCreatures
#        Description: Leave creatures with an NPC flag (vendors, trainers, quest givers, ...) out of the
#                     achievement lists, so a completed list never means raiding the other team's cities.
#        Default:     1 - Enabled

KillCollector.AchievementsEnable = 0
KillCollector.Expected.SkipNpcFlagCreatures = 1

########################################
#  What the achievements pay
########################################
#    KillCollector.DamageBonusPct
#        Description: Percent damage against creatures of one creature type that EACH earned achievement of that
#                     type pays, wherever the creature is (one achievement per continent, so up to five per type).
#                     Counts for the player's own damage and for what it controls or owns (pets, guardians,
#                     totems); never against players or units a player controls. It reads the earned
#                     achievements, so it works with AchievementsEnable = 0, too.
#        Default:     5 - +5% per achievement, +25% against a type when all five of its lists are earned
#                     0 - no bonus
#    KillCollector.MetaAchievementId
#        Description: The achievement granted once the player has earned every bucket achievement its team can
#                     earn (needs AchievementsEnable = 1 and the achievement's rows in Achievement.dbc /
#                     achievement_dbc; its title comes from the achievement_reward and chartitles_dbc rows of
#                     this module's SQL).
#        Default:     30051 - "N3rd", title "N3rd %s"
#                     0     - no meta achievement

KillCollector.DamageBonusPct = 5
KillCollector.MetaAchievementId = 30051

########################################
#  Logging
########################################
#    KillCollector.LogVerbose
#        Description: Log every newly collected creature.
#        Default:     0 - Disabled

KillCollector.LogVerbose = 0
